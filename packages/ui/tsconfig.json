{
  "extends": "@repo/typescript-config/react-library.json",
  "compilerOptions": {
    "outDir": "dist",
    // Source is consumed by the apps' bundler, never emitted by tsc. NodeNext
    // also rejects the extensionless re-exports in @phosphor-icons/react's types.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strictNullChecks": true,
  },
  "include": ["src", "__tests__"],
  "exclude": ["node_modules", "dist"],
}
