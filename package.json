{
  "name": "pelintir",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "bunx turbo dev --filter=web",
    "dev:api": "bunx turbo dev --filter=api",
    "dev:dashboard": "bunx turbo dev --filter=dashboard",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "migrate": "bunx turbo run migrate --filter=api"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.7",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
